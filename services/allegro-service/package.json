{
  "name": "allegro-service",
  "version": "1.0.0",
  "description": "Allegro Service for Allegro Integration System",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc && tsc-alias",
    "start": "node dist/main.js",
    "start:dev": "ts-node src/main.ts",
    "start:watch": "ts-node-dev --respawn src/main.ts",
    "import:allegro-offers:catalog": "node dist/scripts/import-allegro-offers-to-catalog.js",
    "import:order-offers:catalog": "node dist/scripts/import-order-offer-products.js",
    "audit:current-stock-source": "node dist/scripts/audit-current-stock-source.js",
    "audit:raw-payload-retention": "node dist/scripts/audit-raw-payload-retention.js",
    "import:current-stock:warehouse": "node dist/scripts/import-current-allegro-stock-to-warehouse.js",
    "export:catalog-products:allegro": "node dist/scripts/export-catalog-products-to-allegro.js",
    "reconcile:availability": "node dist/scripts/reconcile-catalog-availability.js",
    "verify:shipment-status-snapshot": "ts-node src/allegro/shipments/shipment-status-snapshot.mapper.spec.ts",
    "verify:warehouse-shipment-correlation": "ts-node src/allegro/shipments/warehouse-shipment-correlation.client.spec.ts",
    "verify:shipment-status-source": "ts-node src/allegro/shipments/shipment-status-source.client.spec.ts",
    "verify:shipment-status-projection": "ts-node src/allegro/shipments/shipment-status-projection.service.spec.ts",
    "verify:shipment-status-redacted-scan": "ts-node src/allegro/shipments/shipment-status-redacted-scan.service.spec.ts",
    "verify:shipment-status-handoff": "ts-node src/allegro/shipments/shipment-status-handoff.service.spec.ts",
    "verify:shipment-status-replay": "ts-node src/scripts/replay-shipment-status-handoff.spec.ts",
    "replay:shipment-status-handoff": "ts-node src/scripts/replay-shipment-status-handoff.ts",
    "verify:shipment-status-snapshot-export": "ts-node src/scripts/export-shipment-status-snapshots.spec.ts",
    "export:shipment-status-snapshots": "ts-node src/scripts/export-shipment-status-snapshots.ts"
  },
  "dependencies": {
    "@allegro/shared": "file:../../shared",
    "@nestjs/axios": "^3.0.1",
    "@nestjs/common": "^10.0.0",
    "@nestjs/config": "^3.0.0",
    "@nestjs/core": "^10.0.0",
    "@nestjs/platform-express": "^10.0.0",
    "@prisma/client": "^5.7.1",
    "amqplib": "^0.10.9",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@types/amqplib": "^0.10.8",
    "@types/node": "^20.10.0",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "tsc-alias": "^1.8.16",
    "typescript": "^5.3.3"
  }
}
